+extern "C" cudaError_t rek_g1_cuda_semantic_deactivate(
+        const RekG1CudaSemanticBuffers* b, const uint8_t* selected,
+        size_t count, cudaStream_t stream) {
+    if (!count) return cudaSuccess;
+    if (!b || !selected) return cudaErrorInvalidValue;
+    deactivate_kernel<<<blocks_for(count), THREADS, 0, stream>>>(b,selected,count);
+    return cudaGetLastError();
+}
