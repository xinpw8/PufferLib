+__global__ void deactivate_kernel(const RekG1CudaSemanticBuffers* buffers,
+        const uint8_t* selected, size_t count) {
+    const auto& b = *buffers;
+    for (size_t i = size_t(blockIdx.x) * blockDim.x + threadIdx.x;
+            i < count; i += size_t(blockDim.x) * gridDim.x) {
+        if (!selected[i]) continue;
+        auto& row = b.rows[i];
+        if (row.status) continue;
+        auto candidate = b.composers[i];
+        // Original physical RobotInputController.Deactivate: unconditional
+        // CancelAction, ordinary PlayIdle, zero VelocityCommand, three flags.
+        auto status = sonic_motion_composer_native_cancel_action(&candidate);
+        if (!status) status = sonic_motion_composer_native_play_action(
+            &candidate, &b.routes[0].clip, &b.routes[0].config);
+        if (status) { row.status=300+int(status); write_outputs(b,i); continue; }
+        b.composers[i] = candidate;
+        row.effective_velocity = {};
+        row.locomotion.locomotion_active = 0;
+        row.locomotion.stop_braking = 0;
+        row.locomotion.has_momentum = 0;
+        row.active_route_id = REK_G1_NATIVE_IDLE;
+        write_outputs(b,i);
+    }
+}
