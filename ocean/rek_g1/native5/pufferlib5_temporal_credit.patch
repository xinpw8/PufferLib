+    int state_n = (int)numel(p->boundary_state.shape);
+    zero_term_state<<<grid_size(state_n), BLOCK_SIZE, 0, stream>>>(
+        p->boundary_state, p->env.terminals, 0, 0, n);
+    Prec decoder = arch_forward(&policy->arch, policy->weights,
+        policy->buf_acts[0], p->boundary_observations, p->boundary_state, stream);
+    copy_boundary_values<<<grid_size(n), BLOCK_SIZE, 0, stream>>>(decoder, p->boundary_values);
