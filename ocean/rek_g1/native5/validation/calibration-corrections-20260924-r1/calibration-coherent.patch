diff --git a/ocean/rek_g1/native5/calibrated_contact.h b/ocean/rek_g1/native5/calibrated_contact.h
new file mode 100644
--- /dev/null
+++ b/ocean/rek_g1/native5/calibrated_contact.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "recovered_contact_rules.cuh"
+#include <cstdint>
+#ifdef __CUDACC__
+#define REK_CALIBRATION_HD __host__ __device__ inline
+#else
+#define REK_CALIBRATION_HD inline
+#endif
+namespace rek_calibrated_contact {
+REK_CALIBRATION_HD bool allow(bool live,bool coherent,int attack_lands){
+    return !live||!coherent||attack_lands!=0;
+}
+REK_CALIBRATION_HD rek5_recovered::Result score(bool allowed,
+        RekG1HitDetectorState& state,const RekG1HitDetectorConfig& config,
+        const RekG1StrikeIntent& intent,int fighter,int limb,float speed,float time){
+    if(!allowed)return {0,0,-1};
+    return rek5_recovered::score(state,config,intent,fighter,limb,speed,time);
+}
+REK_CALIBRATION_HD std::uint32_t hash(std::uint32_t value){
+    value^=value>>16;value*=0x7feb352du;value^=value>>15;value*=0x846ca68bu;
+    return value^(value>>16);
+}
+REK_CALIBRATION_HD std::uint32_t episode_key(std::uint32_t seed,
+        std::uint32_t calibration_seed,std::uint32_t arena,std::uint32_t round){
+    return hash(seed^hash(calibration_seed+0x73fa421bu)^hash(arena+0x9e3779b9u)^hash(round+0x85ebca6bu));
+}
+REK_CALIBRATION_HD std::uint32_t draw_key(bool independent,std::uint32_t legacy,
+        std::uint32_t episode,std::uint32_t side){
+    return independent?hash(legacy^episode^hash(side+0xa511e9b3u)):legacy;
+}
+}
+#undef REK_CALIBRATION_HD
diff --git a/ocean/rek_g1/native5/test_calibrated_contact.cpp b/ocean/rek_g1/native5/test_calibrated_contact.cpp
new file mode 100644
--- /dev/null
+++ b/ocean/rek_g1/native5/test_calibrated_contact.cpp
@@ -0,0 +1,48 @@
+#include "calibrated_contact.h"
+#include <cassert>
+#include <cstring>
+#include <cstdio>
+#include <set>
+int main(){
+    using namespace rek_calibrated_contact;
+    const RekG1HitDetectorConfig config{1.75f,2.f,.3f,.2f};
+    const RekG1ImpactEvent event{.2f,.1f,.1f,0,REK_G1_AIM_LIMB_LEFT_LOWER_BODY};
+    RekG1StrikeIntent intent{&event,1,10.f,50.f,1,1,1,0};
+    for(int side=0;side<2;side++){
+        RekG1HitDetectorState state{},before=state;
+        auto rejected=score(allow(true,true,0),state,config,intent,side,0,3.f,1.f);
+        assert(rejected.points==0&&std::memcmp(&state,&before,sizeof state)==0);
+        auto accepted=score(allow(true,true,1),state,config,intent,side,0,3.f,1.f);
+        assert(accepted.points==2&&state.cooldown_seen[side][0]);
+        assert(state.scored_move_seen[side]&&state.scored_apex_mask[side]==1);
+        before=state;intent.move_id=2;
+        rejected=score(allow(true,true,0),state,config,intent,side,0,3.f,2.f);
+        assert(rejected.points==0&&std::memcmp(&state,&before,sizeof state)==0);
+        accepted=score(allow(true,true,1),state,config,intent,side,0,3.f,2.f);
+        assert(accepted.points==2&&state.scored_move_id[side]==2);
+        auto duplicate=score(true,state,config,intent,side,0,3.f,2.5f);
+        assert(duplicate.points==0&&duplicate.reject==rek5_recovered::Duplicate);
+        intent.move_id=3;
+        auto cooldown=score(true,state,config,intent,side,0,3.f,2.1f);
+        assert(cooldown.points==0&&cooldown.reject==rek5_recovered::Cooldown);
+        intent.move_id=1;
+    }
+    for(bool live:{false,true})for(bool coherent:{false,true})for(int lands:{0,1}){
+        RekG1HitDetectorState state{},reference{};
+        const auto actual=score(allow(live,coherent,lands),state,config,intent,0,0,3.f,1.f);
+        if(live&&coherent&&!lands){assert(actual.points==0);continue;}
+        const auto expected=rek5_recovered::score(reference,config,intent,0,0,3.f,1.f);
+        assert(actual.points==expected.points&&std::memcmp(&state,&reference,sizeof state)==0);
+    }
+    std::set<std::uint32_t> keys;
+    for(unsigned arena=0;arena<64;arena++)for(unsigned round=1;round<5;round++)for(unsigned side=0;side<2;side++){
+        const auto episode=episode_key(123,73,arena,round);
+        const auto key=draw_key(true,999,episode,side);
+        assert(key==draw_key(true,999,episode_key(123,73,arena,round),side));
+        assert(draw_key(false,999,episode,side)==999);
+        assert(keys.insert(key).second);
+    }
+    assert(episode_key(123,73,0,1)!=episode_key(124,73,0,1));
+    assert(episode_key(123,73,0,1)!=episode_key(123,74,0,1));
+    std::puts("PASS: rejected/accepted credit, cooldown/dedup, default-off equivalence, reproducible distinct arena/round/side keys");
+}
