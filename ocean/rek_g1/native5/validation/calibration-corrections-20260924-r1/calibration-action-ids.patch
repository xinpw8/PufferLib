diff --git a/ocean/rek_g1/native5/calibration_action_ids.h b/ocean/rek_g1/native5/calibration_action_ids.h
new file mode 100644
--- /dev/null
+++ b/ocean/rek_g1/native5/calibration_action_ids.h
@@ -0,0 +1,28 @@
+#pragma once
+#ifdef __CUDACC__
+#define REK_CALIBRATION_ACTION_HD __host__ __device__ inline
+#else
+#define REK_CALIBRATION_ACTION_HD inline
+#endif
+namespace rek_calibration_action_ids {
+REK_CALIBRATION_ACTION_HD int table_key(bool action_ids,int action,int native_move){
+    return action_ids?action-16:native_move;
+}
+REK_CALIBRATION_ACTION_HD bool kick_penalty(bool action_ids,int action,int native_move){
+    return action_ids?action==16:native_move==0;
+}
+REK_CALIBRATION_ACTION_HD float hit_probability(int key,bool in_range,bool behind){
+    float p;
+    switch(key){
+        case 0: p=in_range?.31f:.16f; if(behind)p=0.f; break;
+        case 5: p=in_range?.09f:.01f; break;
+        case 7: p=in_range?.10f:.01f; break;
+        case 9: p=in_range?.04f:.0f; break;
+        case 10: p=in_range?.23f:.17f; if(behind)p*=.35f; break;
+        case 14: p=.02f; break;
+        default: p=in_range?.05f:.01f; break;
+    }
+    return p;
+}
+}
+#undef REK_CALIBRATION_ACTION_HD
diff --git a/ocean/rek_g1/native5/test_calibration_action_ids.cpp b/ocean/rek_g1/native5/test_calibration_action_ids.cpp
new file mode 100644
--- /dev/null
+++ b/ocean/rek_g1/native5/test_calibration_action_ids.cpp
@@ -0,0 +1,36 @@
+#include "calibration_action_ids.h"
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <initializer_list>
+int main(){
+    using namespace rek_calibration_action_ids;
+    // Pinned fast_assets.cpp move_order for policy categories 16 through 32.
+    const int native_moves[17]={6,7,8,9,0,1,2,3,4,5,10,11,12,13,14,15,16};
+    int action_for_native[17]{};
+    for(int i=0;i<17;i++)action_for_native[native_moves[i]]=16+i;
+    const float near_rates[17]={.31f,.05f,.05f,.05f,.05f,.09f,.05f,.10f,.05f,.04f,.23f,.05f,.05f,.05f,.02f,.05f,.05f};
+    const float far_rates[17]={.16f,.01f,.01f,.01f,.01f,.01f,.01f,.01f,.01f,.0f,.17f,.01f,.01f,.01f,.02f,.01f,.01f};
+    for(int i=0;i<17;i++){
+        const int action=16+i,native=native_moves[i];
+        assert(action_for_native[native]==action);
+        assert(table_key(true,action,native)==i);
+        assert(table_key(false,action,native)==native);
+        assert(kick_penalty(true,action_for_native[native],native)==(action==16));
+        assert(kick_penalty(false,action_for_native[native],native)==(native==0));
+        for(bool close:{false,true})for(bool behind:{false,true}){
+            float expected=close?near_rates[i]:far_rates[i];
+            if(behind&&i==0)expected=0;
+            if(behind&&i==10)expected*=.35f;
+            const float actual=hit_probability(table_key(true,action,native),close,behind);
+            assert(std::fabs(actual-expected)<1e-7f);
+            assert(hit_probability(table_key(false,action,native),close,behind)==hit_probability(native,close,behind));
+        }
+    }
+    assert(native_moves[0]==6&&action_for_native[0]==20);
+    assert(hit_probability(table_key(true,16,6),true,false)==.31f);
+    assert(hit_probability(table_key(false,16,6),true,false)==.05f);
+    assert(kick_penalty(true,16,6)&&!kick_penalty(true,20,0));
+    assert(!kick_penalty(false,16,6)&&kick_penalty(false,20,0));
+    std::puts("PASS: all 17 action/native mappings; existing probability values for near/far and front/behind; corrected kick target; default-off keys and penalty unchanged");
+}
