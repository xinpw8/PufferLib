[base]
env_name = breakout
async = 1

[vec]
total_agents = 2048
num_buffers = 1
num_threads = 8
gpu_env = 1

[policy]
num_layers = 3
hidden_size = 64

[env]
num_agents = 1
frameskip = 3
width = 576
height = 330
initial_paddle_width = 62
paddle_width = 62
paddle_height = 8
ball_width = 32
ball_height = 32
brick_width = 32
brick_height = 12
brick_rows = 6
brick_cols = 18
initial_ball_speed = 256
max_ball_speed = 448
paddle_speed = 620
continuous = 0

[train]
total_timesteps = 32_596_516
learning_rate = 0.06830547
gamma = 0.966619134
gae_lambda = 0.995
replay_ratio = 2.47526479
clip_coef = 0.537072837
vf_coef = 2.70584917
vf_clip_coef = 5
max_grad_norm = 0.178807378
ent_coef = 0.00313184666
momentum = 0.852630615
muon_grad_scale = 1
minibatch_size = 32768
horizon = 32
prio_alpha = 0
prio_beta0 = 0
vtrace_c_clip = 1.0
vtrace_rho_clip = 1.0
advantage_is = 1
offpol_mom = 1
offpol_min_overlap = 0.8
offpol_min_trust = 0.5

[sweep.train.total_timesteps]
distribution = log_normal
min = 3e7
max = 6e7
mean = 4e7
scale = auto

[sweep.env.frameskip]
distribution = int_uniform
min = 2
max = 4
mean = 3
scale = 1.0

[sweep.policy.hidden_size]
distribution = uniform_pow2
min = 32
max = 64
scale = auto

[sweep.policy.num_layers]
distribution = uniform
min = 3
max = 5
scale = auto

[sweep.vec.total_agents]
distribution = uniform_pow2
min = 2048
max = 4096
scale = auto

[sweep.train.horizon]
distribution = uniform_pow2
min = 32
max = 64
scale = auto

[sweep.train.minibatch_size]
distribution = uniform_pow2
min = 16384
max = 65536
scale = auto

[sweep.train.offpol_kl_target]
distribution = log_normal
min = 0.05
max = 1.0
mean = 0.5
scale = 0.5
